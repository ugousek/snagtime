# Copy to deploy/.env and fill in. Then run: ./deploy/setup.sh

# Public domain of the app. Its DNS A record must point to this server.
APP_DOMAIN=rezervace.example.cz
# Contact e-mail for Let's Encrypt certificates.
ACME_EMAIL=admin@example.cz

# Outgoing e-mail (registration, booking confirmations). Port 465 = implicit, 587 = starttls.
SMTP_HOST=smtp.example.cz
SMTP_PORT=465
SMTP_TLS_MODE=implicit
SMTP_USER=rezervace@example.cz
# The SMTP password goes into deploy/secrets/smtp_password (setup.sh asks for it).
EMAIL_FROM="Rezervace <rezervace@example.cz>"
EMAIL_REPLY_TO=info@example.cz
EMAIL_SENDER_DOMAIN=example.cz

# Optional integrations. Leave as local/none to run without Google Calendar and online payments.
CALENDAR_PROVIDER=local
PAYMENTS_PROVIDER=none
# Needed only when CALENDAR_PROVIDER=google (secret goes to deploy/secrets/google_client_secret).
GOOGLE_CLIENT_ID=

# Provozovatel SaaS: e-maily (oddělené čárkou), které uvidí Správu provozoven na /admin.
# Účet s tímto e-mailem si založ normálně přes /signup a ověř e-mail.
PLATFORM_ADMIN_EMAILS=
# Kam provozovny píšou o změnu tarifu (tlačítko „Chci tento tarif“). Výchozí je EMAIL_REPLY_TO.
PLATFORM_CONTACT_EMAIL=
